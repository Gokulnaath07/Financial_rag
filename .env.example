# Phase 4 — Retrieval & Answering config
# Copy this file to `.env` and fill in your Gemini API key.
# The .env file is gitignored — your key never gets committed.
#
# Get a free Gemini API key at: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=

# Optional overrides (all have sane defaults in config.py — uncomment to override):
# LLM_MODEL=gemini-2.0-flash
# LLM_TEMPERATURE=0.1
# LLM_MAX_OUTPUT_TOKENS=1024
# NOT_FOUND_THRESHOLD=0.35
# TOP_K_FOR_PROMPT=5
# RETRIEVAL_TOP_K=5
# RERANK_ENABLED=true
# RERANKER_MODEL=BAAI/bge-reranker-base
